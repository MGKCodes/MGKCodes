# Resend powers the /contact message form. Create a key at https://resend.com
#
# Quotes: only needed when a value contains spaces (e.g. the Option B sender
# below). In the Vercel dashboard, paste raw values with NO quotes at all.

RESEND_API_KEY=

# --- Option A: free (no extra domain) ---
# Uses Resend's shared sender. It can only deliver to your Resend account email,
# so set CONTACT_TO to that address. Reply-To is the submitter, so replies work.
RESEND_FROM=onboarding@resend.dev
CONTACT_TO=your-resend-account-email@example.com

# --- Option B: verified domain (Resend Pro) ---
# Verify mgkcodes.com in Resend, then send from it to the studio inbox.
# (Quotes here because the value contains spaces.)
# RESEND_FROM="MGKCodes <noreply@mgkcodes.com>"
# CONTACT_TO=hello@mgkcodes.com
